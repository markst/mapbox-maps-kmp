# Secrets — never tracked. See README for how integrators configure tokens.
local.properties
*.xcconfig
!*.xcconfig.example
.netrc

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/native/build/

# Kotlin/Native, Kotlin Gradle Plugin
.kotlin/

# Android
*.apk
*.aab
*.ap_
*.dex
.cxx/
captures/

# Xcode / SwiftPM
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/
.swiftpm/
.build/
Package.resolved
# ...except the swiftPMDependencies lock file the Kotlin Gradle plugin manages under
# .swiftpm-locks/ — Kotlin's docs recommend committing it for reproducible resolution.
!.swiftpm-locks/**/Package.resolved

# Generated by `./gradlew :demo:shared:integrateLinkagePackage` (swiftPMDependencies <-> Xcode glue). 
# Regenerated on demand; project.pbxproj's reference to it is what's tracked.
demo/iosApp/KotlinMultiplatformLinkedPackage/

